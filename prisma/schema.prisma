// Modelo de datos - Transportes Toto
// Convenciones:
//  - Importes monetarios: Decimal(14,2). Tarifas: Decimal(14,4) (admite tarifas por kg con decimales).
//  - Kilogramos: Decimal(12,2).
//  - Fechas operativas (fecha del viaje, vigencias): tipo DATE sin hora.
//  - Marcas de tiempo: timestamptz (UTC); la interfaz las muestra en America/Montevideo.
//  - Catálogos: borrado lógico mediante "activo".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModalidadFacturacion {
  FIJO
  POR_PESO
}

enum UnidadTarifa {
  KG
  TONELADA
}

enum BaseCalculo {
  SALIDA
  LLEGADA
  PROMEDIO
  MAYOR
  MENOR
  PROMEDIO_DISPONIBLE
}

enum EstadoViaje {
  BORRADOR
  ABIERTO
  CERRADO
  FACTURADO
  ANULADO
}

model Role {
  id     Int    @id @default(autoincrement())
  codigo String @unique // ADMIN | LOGISTICA | CONSULTA
  nombre String
  users  User[]
}

model User {
  id                 String    @id @default(cuid())
  usuario            String    @unique
  email              String?   @unique
  nombre             String
  passwordHash       String
  roleId             Int
  role               Role      @relation(fields: [roleId], references: [id])
  activo             Boolean   @default(true)
  puedeExportar      Boolean   @default(false)
  debeCambiarClave   Boolean   @default(false)
  intentosFallidos   Int       @default(0)
  bloqueadoHasta     DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  sessions          Session[]
  resetTokens       PasswordResetToken[]
  viajesCreados     Trip[]           @relation("TripCreatedBy")
  viajesModificados Trip[]           @relation("TripUpdatedBy")
  viajesCerrados    Trip[]           @relation("TripClosedBy")
  tripLogs          TripAuditLog[]
  tariffLogs        TariffAuditLog[]
  tarifasCreadas    Tariff[]         @relation("TariffCreatedBy")
  tarifasModif      Tariff[]         @relation("TariffUpdatedBy")
}

model Session {
  id        String   @id // hash SHA-256 del token; el token en claro sólo vive en la cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id // hash SHA-256 del token
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

model Client {
  id            String   @id @default(cuid())
  nombre        String   @unique
  rut           String?
  observaciones String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  tarifas       Tariff[]
  viajes        Trip[]
}

model Driver {
  id        String   @id @default(cuid())
  nombre    String   @unique
  telefono  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  viajes    Trip[]
}

model Vehicle {
  id          String   @id @default(cuid())
  matricula   String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  viajes      Trip[]
}

model CargoType {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  viajes    Trip[]
  tarifas   Tariff[]
}

model Location {
  id         String   @id @default(cuid())
  nombre     String   @unique
  esCarga    Boolean  @default(true)
  esDescarga Boolean  @default(true)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  viajesOrigen   Trip[]   @relation("TripOrigin")
  viajesDestino  Trip[]   @relation("TripDestination")
  tarifasOrigen  Tariff[] @relation("TariffOrigin")
  tarifasDestino Tariff[] @relation("TariffDestination")
}

model Setting {
  clave     String   @id
  valor     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Tariff {
  id             String               @id @default(cuid())
  clientId       String
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  modalidad      ModalidadFacturacion
  importe        Decimal              @db.Decimal(14, 4)
  moneda         String               @default("UYU") @db.VarChar(3)
  unidad         UnidadTarifa?
  baseCalculo    BaseCalculo?
  origenId       String?
  origen         Location?            @relation("TariffOrigin", fields: [origenId], references: [id], onDelete: Restrict)
  destinoId      String?
  destino        Location?            @relation("TariffDestination", fields: [destinoId], references: [id], onDelete: Restrict)
  cargoTypeId    String?
  cargoType      CargoType?           @relation(fields: [cargoTypeId], references: [id], onDelete: Restrict)
  vigenciaDesde  DateTime             @db.Date
  vigenciaHasta  DateTime?            @db.Date
  activo         Boolean              @default(true)
  observaciones  String?
  // Tarifa de la que esta es una nueva vigencia (historial de precios).
  reemplazaAId   String?
  version        Int                  @default(1)
  createdById    String?
  createdBy      User?                @relation("TariffCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?                @relation("TariffUpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  logs   TariffAuditLog[]
  viajes Trip[]

  @@index([clientId, activo, vigenciaDesde])
}

model TariffAuditLog {
  id        String   @id @default(cuid())
  tariffId  String
  tariff    Tariff   @relation(fields: [tariffId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  accion    String
  motivo    String?
  cambios   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tariffId, createdAt])
}

model Trip {
  id      String @id @default(cuid())
  numero  Int    @unique @default(autoincrement())
  fecha   DateTime @db.Date

  vehicleId   String?
  vehicle     Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  driverId    String?
  driver      Driver?    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  cargoTypeId String?
  cargoType   CargoType? @relation(fields: [cargoTypeId], references: [id], onDelete: Restrict)
  cargaDetalle String?
  origenId    String?
  origen      Location?  @relation("TripOrigin", fields: [origenId], references: [id], onDelete: Restrict)
  destinoId   String?
  destino     Location?  @relation("TripDestination", fields: [destinoId], references: [id], onDelete: Restrict)

  kgSalida             Decimal? @db.Decimal(12, 2)
  kgLlegada            Decimal? @db.Decimal(12, 2)
  kgPromedio           Decimal? @db.Decimal(12, 2)
  kgDiferencia         Decimal? @db.Decimal(12, 2)
  porcentajeDiferencia Decimal? @db.Decimal(7, 2)
  kgBase               Decimal? @db.Decimal(12, 2)
  alertaDiferencia     Boolean  @default(false)

  // Datos complementarios del Excel original (opcionales)
  numeroOrden        String?
  numeroPesada       String?
  viaticos           Int?
  estadias           Int?
  liquidacionCliente Decimal? @db.Decimal(14, 2)

  // Tarifa: referencia + copia (snapshot) congelada al cerrar
  tariffId              String?
  tariff                Tariff?               @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  tarifaModalidad       ModalidadFacturacion?
  tarifaImporte         Decimal?              @db.Decimal(14, 4)
  tarifaUnidad          UnidadTarifa?
  tarifaBase            BaseCalculo?
  tarifaVigenciaDesde   DateTime?             @db.Date
  tarifaSnapshot        Json?
  moneda                String                @default("UYU") @db.VarChar(3)
  importeFacturado      Decimal?              @db.Decimal(14, 2)

  estado          EstadoViaje @default(BORRADOR)
  observaciones   String?
  motivoAnulacion String?
  numeroFactura   String?
  fechaFactura    DateTime?   @db.Date

  // Protección contra doble envío
  idempotencyKey String? @unique
  // Bloqueo optimista
  version        Int     @default(1)

  createdById String
  createdBy   User      @relation("TripCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User      @relation("TripUpdatedBy", fields: [updatedById], references: [id])
  closedById  String?
  closedBy    User?     @relation("TripClosedBy", fields: [closedById], references: [id])
  closedAt    DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  logs TripAuditLog[]

  @@index([fecha])
  @@index([clientId, fecha])
  @@index([estado, fecha])
  @@index([vehicleId, fecha])
  @@index([driverId, fecha])
}

model TripAuditLog {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  accion    String // CREAR | EDITAR | CERRAR | REABRIR | FACTURAR | ANULAR
  estadoAnterior EstadoViaje?
  estadoNuevo    EstadoViaje?
  motivo    String?
  cambios   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tripId, createdAt])
}
