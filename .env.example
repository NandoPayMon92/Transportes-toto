# Conexión a PostgreSQL (no usar credenciales reales en este archivo)
DATABASE_URL="postgresql://toto:CAMBIAR_ESTA_CLAVE@localhost:5432/toto?schema=public"

# Base de datos exclusiva para pruebas de integración (se borra en cada ejecución)
TEST_DATABASE_URL="postgresql://toto:CAMBIAR_ESTA_CLAVE@localhost:5432/toto_test?schema=public"

# Zona horaria de visualización
NEXT_PUBLIC_TZ="America/Montevideo"

# Duración de la sesión en horas
SESSION_TTL_HOURS="12"

# Cookie segura (true en producción con HTTPS; false sólo en desarrollo local sin HTTPS)
COOKIE_SECURE="false"

# URL pública de la aplicación (se usa para armar enlaces de restablecimiento de contraseña)
APP_URL="http://localhost:3000"
